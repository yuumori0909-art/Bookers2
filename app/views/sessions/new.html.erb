<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<header>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <span class="navbar-brand">Bookers</span>

      <ul class="navbar-nav flex-row ms-auto">
        <li class="nav-item ms-3">
          <a href="/">
            <i class="fa-solid fa-home"></i>
            home
          </a>  
        </li>
        <li class="nav-item ms-3">
          <a href="/homes/about">
            <i class="fa-solid fa-link"></i>
            About
          </a>  
        </li>
        <li class="nav-item ms-3">
          <a href="/users/sign_up">
            <i class="fa-solid fa-user-plus"></i>
            sign up
          </a>
        </li>
        <li class="nav-item ms-3">
          <a href="/session/new">
            <i class="fa-solid fa-sign-in-alt"></i>
            Log in
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<main>
  <div class="container">
    <div class="row mt-3">
      <div class="col-4 offset-1">
        <h2>Log in</h2>
        <%= form_with url: session_path do |form| %>
          <div class="field">
            <p>name</p>
            <%= form.text_field :name, required: true, autofocus: true, autocomplete: "username", value: params[:name] %><br>
          </div>

          <div class="field">
            <p>password</p>
            <%= form.password_field :password, required: true, autocomplete: "current-password", minlength: 6 %><br>
          </div>

          <div class="actions">
            <%= form.submit "Log in" %>
          </div>
        <% end %>
        <%= link_to "sign_up", new_user_path %>
        <br>
        <%= link_to "Forgot password?", new_password_path %>
      </div>
    </div>
  </div>
</main>

<footer>
  <div class="container-fluid">
    <div class="row justify-content-center mt-5">
      <div class="col-2">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>
