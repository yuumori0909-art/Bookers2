<main>
  <div class="container">
    <div class="row">
      <div class="col-10">
        <% if @target == "User" %>
          <h1>Users search for <%= @word %></h1>
            <table class="table">
            <thead>
              <tr>
                <th colspan="3"></th>
                <th>name</th>
                <th>introduction</th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr>
                  <td>
                    <%= link_to user_path(user) do %>
                      <%= image_tag user.get_profile_image(80,80) %>
                    <% end %>
                  </td>
                  <td><%= user.name %></td>
                  <td><%= user.introduction %></td>
                </tr>
              <% end %>
            </tbody>
            </table>

          <% elsif @target == "Tag" %>
            <h1>Tags search for <%= @word %></h1>
            <table class="table table-hover">
            <thead>
              <tr>
                <th></th>
                <th>Title</th>
                <th>Opinion</th>
                <th>Tag</th>
                <th colspan="5"></th>
              </tr>
            </thead>
            <tbody>
              <% @books.each do |book| %>
                <tr>
                  <td>
                    <%= link_to user_path(book.user) do %>
                      <%= image_tag book.user.get_profile_image(80, 80) %>
                    <% end %>
                  </td>
                  <td><%= link_to book.title, book_path(book) %></td>
                  <td><%= book.body %></td>
                <td>
                  <% if book.category.present? %>
                    <%= link_to book.category, search_path(word: book.category, target: 'Tag') %>
                  <% end %>
                </td>
                <td>
                  <%= turbo_frame_tag dom_id(book, :favorites) do %>
                    <%= render 'favorites/favorite', book: book %>
                  <% end %>
                </td>
                <td>コメント数：<%= book.book_comments.count %></td>
                <td>
                  <div class="star-group" data-score="<%= book.score %>"></div>
                </td>
                </tr>
              <% end %>
            </tbody>
          </table>
          
          <% else %>
            <h1>Books search for <%= @word %></h1>
            <table class="table table-hover">
            <thead>
              <tr>
                <th></th>
                <th>Title</th>
                <th>Opinion</th>
              </tr>
            </thead>
            <tbody>
              <% @books.each do |book| %>
                <tr>
                  <td>
                    <%= link_to user_path(book.user) do %>
                      <%= image_tag book.user.get_profile_image(80, 80) %>
                    <% end %>
                  </td>
                  <td><%= link_to book.title, book_path(book) %></td>
                  <td><%= book.body %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  </div>
</main>

<footer>
  <div class="container">
    <div class="row">
      <div class="text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>

        
