<main>
  <div class="container px-5 px-sm-0">
    <div class="row mt-3">

      <%= render 'info', book: @book, user: @user %>

      <div class="col-md-8 offset-md-1">
        <h2>Users</h2>
        <table class="table">
          <thead>
            <tr>
              <th>image</th>
              <th>name</th>
              <th colspan="2"></th>
              <th colspan="2"></th>
              <th colspan="2"></th>
              <th colspan="2"></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td><%= link_to user_path(user) do %>
                      <%= image_tag user.get_profile_image(50,50) %>
                    <% end %>
                </td>
                <td><%= user.name %></td>
                <td>フォロー数： <%= user.followings.count %></td>
                <td>フォロワー数： <%= user.followers.count %></td>
                <td><% if Current.user != user %>
                  <% if Current.user.following?(user) %>
                    <%= link_to "フォロー外す", user_relationships_path(user), data: { turbo_method: :delete }, class: "btn btn-info" %> 
                    <% else %>
                    <%= link_to "フォローする", user_relationships_path(user), data: { turbo_method: :post}, class: "btn btn-success" %>
                  <% end %>
                <% end %></td> 
                <td><%= link_to "Show", user_path(user) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>
<footer>
  <div class="container">
    <div class="row">
      <div class="text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>