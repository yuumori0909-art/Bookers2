<% if @user.errors.any? %>
  <div id="error_explanation">
    <h3><%= @user.errors.count %> error prohibited this obj from being saved:</h3>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="container mt-3">
  <div class="row">
    <div class="col-md-6 mx-auto">
      <h2>User info</h2>

      <%= form_with model: @user do |f| %>
        <div class="mb-3">
          <%= f.label :name, "Name", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :profile_image, "Image", class: "form-label" %>
          <%= f.file_field :profile_image, accept: "image/*", class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :introduction, "Introduction", class: "form-label" %>
          <%= f.text_area :introduction, class: "form-control", rows: 3 %>
        </div>

        <%= f.submit "Update User", class: "btn btn-secondary mb-5" %>
      <% end %>
    </div>
  </div>
</div>

<footer>
  <div class="container">
    <div class="row">
      <div class="text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>