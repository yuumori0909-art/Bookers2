<% if current_user != @user && current_user.following?(@user) && @user.following?(current_user) %>
  <% if @is_room == true %>
      <%= link_to "cahtへ", room_path(@room_id) %>
    <% else %>
      <%= link_to "cahtを始める", rooms_path(user_id: @user.id), data: { turbo_method: :post } %>
    <% end %>
  <% end %>
<% end %>  