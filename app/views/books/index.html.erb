<header>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <span class="navbar-brand">Bookers</span>

      <ul class="navbar-nav flex-row ms-auto">
        <li class="nav-item ms-3">
          <%= link_to user_path(Current.user),class:"nav-link text-light" do %>
            <i class="fa-solid fa-home"></i>
            home
          <% end %>
        </li>
        <li class="nav-item ms-3">
          <%= link_to users_path,class:"nav-link text-light" do %>
            <i class="fa-solid fa-users"></i>
            Users
          <% end %>
        </li>
        <li class="nav-item ms-3">
          <%= link_to books_path,class:"nav-link text-light" do %>
            <i class="fa-solid fa-book-open"></i>
            Books
          <% end %>
        </li>
        <li class="nav-item ms-3">
          <%= link_to root_path,class:"nav-link text-light" do %>
            <i class="fa-solid fa-sign-out-alt"></i>
            Log out
          <% end %>
        </li>
      </ul>
    </div>
  </nav>
</header>

<main>
  <div class="container px-5 px-sm-0">
    <div class="row mt-3">

      <%= render 'users/info', book: @book, user: @user %>

      <div class="col-md-8 offset-md-1">
        <h2>Books</h2>
        <table class="table table-hover">
          <thead>
            <tr>
              <th>image</th>
              <th>Title</th>
              <th colspan="3"></th>
            </tr>
          </thead>
          <tbody>
            <% @books.each do |f| %>
              <tr>
                <td><%= image_tag @user.get_profile_image(100,100) %></td>
                <td><%= link_to book.title, book_path(@books) %></td>
                <td><%= book.body %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>
<footer>
  <div class="container">
    <div class="row">
      <div class="text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>
