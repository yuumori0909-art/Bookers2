<% if @book.errors.any? %>
  <div id="error_explanation">
    <h3><%= @book.errors.count %> errors prohibited this obj from being saved:</h3>
    <ul>
      <% @book.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<main>
  <div class="container px-5 px-sm-0">
    <div class="row mt-3">

      <%= render 'users/info', book: @book, user: @user %>

      <div class="col-md-8 offset-md-1">
        <h2>Books</h2>
        <p>
          <%= link_to '新着順', books_path(latest: "true") %>
          |
          <%= link_to '評価の高い順', books_path(star_count: "true") %>
        </p>
        <table class="table table-hover">
          <thead>
            <tr>
              <th></th>
              <th>Title</th>
              <th>Opinion</th>
              <th>Tag</th>
              <th colspan="5"></th>
            </tr>
          </thead>
          <tbody>
            <% @books.each do |book| %>
              <tr>
                <td>
                  <%= link_to user_path(book.user) do %>
                    <%= image_tag book.user.get_profile_image(100, 100) %>
                  <% end %>
                </td>
                <td><%= link_to book.title, book_path(book) %></td>
                <td><%= book.body %></td>
                <td>
                  <% if book.category.present? %>
                    <%= link_to book.category, search_path(word: book.category, target: 'Tag') %>
                  <% end %>
                </td>
                <td>
                  <%= turbo_frame_tag dom_id(book, :favorites) do %>
                    <%= render 'favorites/favorite', book: book %>
                  <% end %>
                </td>
                <td>コメント数：<%= book.book_comments.count %></td>
                <td>
                  <div class="star-group" data-score="<%= book.score %>"></div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>
<footer>
  <div class="container">
    <div class="row">
      <div class="text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>
