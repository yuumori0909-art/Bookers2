<main>
  <div class="container px-5 px-sm-0">
    <div class="row mt-3">

      <%= render 'users/info', book: @book_new, user: @user %>

      <div class="col-md-8 offset-md-1">
        <h2>Book detail</h2>
        <hr>
        <table class="table">
          <tbody>
              <tr>
                  <td> 
                    <%= link_to user_path(@book.user) do %>
                      <%= image_tag @book.user.get_profile_image(100, 100) %>
                    <% end %>
                    <br>
                    <%= link_to @book.user.name, user_path(@book.user) %>
                  </td>
                <td><%= link_to @book.title, book_path(@book) %></td>
                <td><%= @book.body %></td>
                <td><%= render 'favorite', book: @book , current_user:@current_user %></td>
                <td>コメント数：<%= @book.book_comments.count %></td>
                <% if @user == Current.user %>
                  <td><%= link_to "Edit", edit_book_path(@book), class: "btn btn-success" %></td>
                <% end %>
                <% if @user == Current.user %>
                  <td><%= link_to "Destroy", book_path(@book), class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" } %></td>
                <% end %>
              </tr>
          </tbody>
        </table>

          <div class="book-comments">
            <div>
              <% @book.book_comments.each do |book_comment| %>
                <%= image_tag book_comment.user.get_profile_image(100,100) %>
                <%= book_comment.comment %>
                <% if book_comment.user == Current.user %>
                  <%= link_to "Destroy", book_book_comment_path(book_comment.book, book_comment), class: "btn btn-danger", data: { turbo_method: :delete } %>
                <% end %> 
                <div class="mt-1"><%= link_to book_comment.user.name, user_path(book_comment.user) %></div>
              <% end %>
            </div>
          </div>

          <div class="new-comment">
            <%= form_with model: [@book, @book_comment] do |f| %>
              <div class="form-group">
                <%= f.text_area :comment, rows: '5',class:"form-control w-100" %>
              </div>
                <%= f.submit "送信" , class: "btn btn-secondary mt-2" %>
            <% end %>
          </div>
      </div>
    </div>
  </div>
</main>

<footer>
  <div class="container">
    <div class="row">
      <div class="text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>