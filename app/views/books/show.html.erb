<main>
  <div class="container px-5 px-sm-0">
    <div class="row mt-3">

      <%= render 'users/info', book: @book_new, user: @user %>

      <div class="col-md-8 offset-md-1">
        <h2>Book detail</h2>
        <hr>
        <table class="table">
          <tbody>
              <tr>
                  <td> 
                    <%= link_to user_path(@book.user) do %>
                      <%= image_tag @book.user.get_profile_image(100, 100) %>
                    <% end %>
                    <br>
                    <%= link_to @book.user.name, user_path(@book.user) %>
                  </td>
                  <td><%= link_to @book.title, book_path(@book) %></td>
                  <td><%= @book.body %></td>
                  <td>
                  <%= turbo_frame_tag dom_id(@book, :favorites) do %>
                    <%= render 'favorites/favorite', book: @book %>
                  <% end %>
                  </td>
                  <td>コメント数：<%= @book.book_comments.count %></td>
                  <td><div id="show_raty" data-score="<%= @book.score %>"></div></td>
                  <% if @user == Current.user %>
                     <td><%= link_to "Edit", edit_book_path(@book), class: "btn btn-success" %></td>
                  <% end %>
                  <% if @user == Current.user %>
                    <td><%= link_to "Destroy", book_path(@book), class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: "本当に消しますか？" } %></td>
                  <% end %>
              </tr>
          </tbody>
        </table>
        <div>
          <%= turbo_frame_tag "book-comments-comment" do %>
            <%= render 'book_comments/comment' , book: @book , book_comment: @book_comment %>
          <% end %>
        </div>
        <div>
          <%= turbo_frame_tag "book-comments-form" do %>
            <%= render 'book_comments/form' , book: @book , book_comment: @book_comment %>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</main>

<footer>
  <div class="container">
    <div class="row">
      <div class="text-center">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
</footer>