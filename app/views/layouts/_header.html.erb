<header>
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <%= link_to "Bookers", root_path, class: "navbar-brand" %>

      <ul class="navbar-nav flex-row ms-auto">
        <% if authenticated? %>
          <!-- ログイン後のメニュー -->
          <li class="nav-item ms-3">
            <%= link_to user_path(Current.user), class: "nav-link text-light" do %>
              <i class="fa-solid fa-home"></i>
              Home
            <% end %>
          </li>
          <li class="nav-item ms-3">
            <%= link_to users_path, class: "nav-link text-light" do %>
              <i class="fa-solid fa-users"></i>
              Users
            <% end %>
          </li>
          <li class="nav-item ms-3">
            <%= link_to books_path, class: "nav-link text-light" do %>
              <i class="fa-solid fa-book-open"></i>
              Books
            <% end %>
          </li>
          <li class="nav-item ms-3">
            <%= link_to session_path, data: { turbo_method: :delete }, class: "nav-link text-light" do %>
              <i class="fa-solid fa-sign-out-alt"></i>
              Log out
            <% end %>
          </li>

        <% else %>
          <!-- ログイン前のメニュー -->
          <li class="nav-item ms-3">
            <%= link_to root_path, class: "nav-link text-light" do %>
              <i class="fa-solid fa-home"></i>
              Home
            <% end %>
          </li>
          <li class="nav-item ms-3">
            <%= link_to about_path, class: "nav-link text-light" do %>
              <i class="fa-solid fa-link"></i>
              About
            <% end %>
          </li>
          <li class="nav-item ms-3">
            <%= link_to new_user_path, class: "nav-link text-light" do %>
              <i class="fa-solid fa-user-plus"></i>
              Sign up
            <% end %>
          </li>
          <li class="nav-item ms-3">
            <%= link_to new_session_path, class: "nav-link text-light" do %>
              <i class="fa-solid fa-sign-in-alt"></i>
              Log in
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </nav>
</header>