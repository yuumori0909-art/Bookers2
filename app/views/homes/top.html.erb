
<main class="container-fluid">
  <div class="row justify-content-center mt-2">
    <div class="col-5">
      <h1>
        Welcome to
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        <strong>Bookers</strong> !!
      </h1>

      <p>
        In
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        <strong>Bookers</strong>,
      </p>

      <p>
        you can share and exchange your opinions, impressions, and emotions<br>
        about various books!
      </p>
    </div>
  </div>

  <div class="btn-wrapper d-flex flex-column align-items-center mt-4 gap-3">

    <%= link_to "Log in", new_session_path,
      class: "btn btn-info btn-sm btn-block mb-3 sign_in" %>

    <%= link_to "Sign up", new_user_path,
      class: "btn btn-success btn-sm btn-block sign_up" %>
  </div>
</main>

<footer>
  <div class="container-fluid">
    <div class="row justify-content-center mt-5">
      <div class="col-2">
        <p>CopyRight Infratop.inc</p>
      </div>
    </div>
  </div>
