
<main class="container">
  <div class="row mt-2">
    <div class="col-5 mx-auto">
      <h1>
        Welcome to
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        <strong>Bookers</strong> !!
      </h1>

      <p>
        In
        <i class="fa-solid fa-book" aria-hidden="true"></i>
        <strong>Bookers</strong>,
      </p>

      <p>
        you can share and exchange your opinions, impressions, and emotions<br>
        about various books!
      </p>
    </div>
  </div>

  <div class="btn-wrapper col-4 mx-auto">
    <div class="row">
      <%= link_to "Log in", new_session_path,
        class: "btn btn-info btn-sm btn-block mb-3 sign_in" %>
    </div>
    <div class="row">
      <%= link_to "Sign up", new_user_path,
        class: "btn btn-success btn-sm btn-block sign_up" %>
    </div>
  </div>
</main>

<footer>
  <div class="container">
    <div class="row mt-5">
      <div class="text-center">
